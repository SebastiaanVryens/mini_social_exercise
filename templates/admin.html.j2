{% extends "base.html.j2" %}

{% block content %}
<div class="container-fluid">
    <h1 class="">Admin Dashboard</h1>

<!-- Tabs for navigation -->
<ul class="nav nav-tabs mb-4" id="adminTab" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link {% if current_tab == 'users' %}active{% endif %}" 
                id="users-tab" data-bs-toggle="tab" data-bs-target="#users" 
                type="button" role="tab" aria-controls="users" 
                aria-selected="{% if current_tab == 'users' %}true{% else %}false{% endif %}"
                onclick="window.location.href = '{{ url_for('admin_dashboard', tab='users', users_page=users_page) }}'">
            Users
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link {% if current_tab == 'posts' %}active{% endif %}" 
                id="posts-tab" data-bs-toggle="tab" data-bs-target="#posts" 
                type="button" role="tab" aria-controls="posts" 
                aria-selected="{% if current_tab == 'posts' %}true{% else %}false{% endif %}"
                onclick="window.location.href = '{{ url_for('admin_dashboard', tab='posts', posts_page=posts_page) }}'">
            Posts
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link {% if current_tab == 'comments' %}active{% endif %}" 
                id="comments-tab" data-bs-toggle="tab" data-bs-target="#comments" 
                type="button" role="tab" aria-controls="comments" 
                aria-selected="{% if current_tab == 'comments' %}true{% else %}false{% endif %}"
                onclick="window.location.href = '{{ url_for('admin_dashboard', tab='comments', comments_page=comments_page) }}'">
            Comments
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link {% if current_tab == 'reminders' %}active{% endif %}"
                id="reminders-tab" data-bs-toggle="tab" data-bs-target="#reminders"
                type="button" role="tab" aria-controls="reminders"
                aria-selected="{% if current_tab == 'reminders' %}true{% else %}false{% endif %}"
                onclick="window.location.href = '{{ url_for('admin_dashboard', tab='reminders') }}'">
            Reminders
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link {% if current_tab == 'appeals' %}active{% endif %}"
                id="appeals-tab" data-bs-toggle="tab" data-bs-target="#appeals"
                type="button" role="tab" aria-controls="appeals"
                aria-selected="{% if current_tab == 'appeals' %}true{% else %}false{% endif %}"
                onclick="window.location.href = '{{ url_for('admin_dashboard', tab='appeals') }}'">
            Appeals
            {% if appeals_pending %}<span class="badge rounded-pill text-bg-danger">{{ appeals_pending }}</span>{% endif %}
        </button>
    </li>
</ul>

<!-- Tab Content -->
<div class="tab-content" id="adminTabContent">

    <!-- Users Tab -->
    <div class="tab-pane fade {% if current_tab == 'users' %}show active{% endif %}" id="users" role="tabpanel" aria-labelledby="users-tab">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Username</th>
                        <th>Profile Bio</th>
                        <th>Created At</th>
                        <th>Risk Level</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                    <tr>
                        <td>{{ user.id }}</td>
                        <td><a href="{{ url_for('user_profile', username=user.username) }}">{{ user.username }}</a></td>
                        <td style="max-width: 300px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="{{ user.profile or 'N/A' }}">{{ user.profile or 'N/A' }}</td>
                        <td>{{ user.created_at|datetimeformat }}</td>
                        <td>
                            {% if user.risk_label == "HIGH" %}
                                <span class="badge bg-danger">HIGH</span>
                            {% elif user.risk_label == "MEDIUM" %}
                                <span class="badge bg-warning text-dark">MEDIUM</span>
                            {% elif user.risk_label == "LOW" %}
                                <span class="badge bg-info text-dark">LOW</span>
                            {% else %}
                                <span class="badge bg-secondary">NONE</span>
                            {% endif %}
                            <span class="ms-2">({{ user.risk_score }})</span>
                        </td>
                        <td>
                            <form action="{{ url_for('admin_delete_user', user_id=user.id) }}" method="POST" onsubmit="return confirm('WARNING: Deleting a user will also delete ALL their posts, comments, and reactions. This cannot be undone. Are you sure?');">
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        
        {# Users Pagination UI #}
        <div class="d-flex justify-content-center align-items-center my-4">
            <a href="{{ url_for('admin_dashboard', tab='users', users_page=users_page-1) }}"
              class="btn btn-primary {% if not users_has_prev %}btn-light disabled{% endif %}">
              &laquo; Previous
            </a>
            <span class="mx-3 text-muted">Page {{ users_page }} of {{ total_users_pages }}</span>
            <a href="{{ url_for('admin_dashboard', tab='users', users_page=users_page+1) }}"
              class="btn btn-primary {% if not users_has_next %}btn-light disabled{% endif %}">
              Next &raquo;
            </a>
        </div>
    </div>
    

    <!-- Posts Tab -->
    <div class="tab-pane fade {% if current_tab == 'posts' %}show active{% endif %}" id="posts" role="tabpanel" aria-labelledby="posts-tab">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Author</th>
                        <th>Content</th>
                        <th>Created At</th>
                        <th>Risk Level</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for post in posts %}
                    <tr>
                        <td>{{ post.id }}</td>
                        <td><a href="{{ url_for('user_profile', username=post.username) }}">{{ post.username }}</a></td>
                        <td style="max-width: 400px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="{{ post.content }}"><a href="{{ url_for('post_detail', post_id=post.id) }}">{{ post.content }}</a></td>
                        <td>{{ post.created_at|datetimeformat }}</td>
                        <td>
                            {% if post.risk_label == "HIGH" %}
                                <span class="badge bg-danger">HIGH</span>
                            {% elif post.risk_label == "MEDIUM" %}
                                <span class="badge bg-warning text-dark">MEDIUM</span>
                            {% elif post.risk_label == "LOW" %}
                                <span class="badge bg-info text-dark">LOW</span>
                            {% else %}
                                <span class="badge bg-secondary">NONE</span>
                            {% endif %}
                            <span class="ms-2">({{ post.risk_score }})</span>
                        </td>
                        <td>
                            <form action="{{ url_for('admin_delete_post', post_id=post.id) }}" method="POST" onsubmit="return confirm('Are you sure you want to delete this post?');">
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {# Posts Pagination UI #}
        <div class="d-flex justify-content-center align-items-center my-4">
            <a href="{{ url_for('admin_dashboard', tab='posts', posts_page=posts_page-1) }}"
              class="btn btn-primary {% if not posts_has_prev %}btn-light disabled{% endif %}">
              &laquo; Previous
            </a>
            <span class="mx-3 text-muted">Page {{ posts_page }} of {{ total_posts_pages }}</span>
            <a href="{{ url_for('admin_dashboard', tab='posts', posts_page=posts_page+1) }}"
              class="btn btn-primary {% if not posts_has_next %}btn-light disabled{% endif %}">
              Next &raquo;
            </a>
        </div>
    </div>

    <!-- Comments Tab -->
    <div class="tab-pane fade {% if current_tab == 'comments' %}show active{% endif %}" id="comments" role="tabpanel" aria-labelledby="comments-tab">
         <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Author</th>
                        <th>Content</th>
                        <th>Created At</th>
                        <th>Risk Level</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for comment in comments %}
                    <tr>
                        <td>{{ comment.id }}</td>
                        <td><a href="{{ url_for('user_profile', username=comment.username) }}">{{ comment.username }}</a></td>
                        <td style="max-width: 400px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="{{ comment.content }}">{{ comment.content }}</td>
                        <td>{{ comment.created_at|datetimeformat }}</td>
                        <td>
                            {% if comment.risk_label == "HIGH" %}
                                <span class="badge bg-danger">HIGH</span>
                            {% elif comment.risk_label == "MEDIUM" %}
                                <span class="badge bg-warning text-dark">MEDIUM</span>
                            {% elif comment.risk_label == "LOW" %}
                                <span class="badge bg-info text-dark">LOW</span>
                            {% else %}
                                <span class="badge bg-secondary">NONE</span>
                            {% endif %}
                            <span class="ms-2">({{ comment.risk_score }})</span>
                        </td>
                        <td>
                            <form action="{{ url_for('admin_delete_comment', comment_id=comment.id) }}" method="POST" onsubmit="return confirm('Are you sure you want to delete this comment?');">
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        
        {# Comments Pagination UI #}
        <div class="d-flex justify-content-center align-items-center my-4">
            <a href="{{ url_for('admin_dashboard', tab='comments', comments_page=comments_page-1) }}"
              class="btn btn-primary {% if not comments_has_prev %}btn-light disabled{% endif %}">
              &laquo; Previous
            </a>
            <span class="mx-3 text-muted">Page {{ comments_page }} of {{ total_comments_pages }}</span>
            <a href="{{ url_for('admin_dashboard', tab='comments', comments_page=comments_page+1) }}"
              class="btn btn-primary {% if not comments_has_next %}btn-light disabled{% endif %}">
              Next &raquo;
            </a>
        </div>
    </div>

    <!-- Reminders Tab: results of the "check before posting" feature (Design Claim 20) -->
    <div class="tab-pane fade {% if current_tab == 'reminders' %}show active{% endif %}" id="reminders" role="tabpanel" aria-labelledby="reminders-tab">
        <p class="text-muted">
            Members who submit a post or comment that breaks the rules get a reminder before it is published.
            This shows what they did next.
        </p>

        <div class="row g-3 mb-4">
            <div class="col-6 col-lg-3">
                <div class="card h-100"><div class="card-body">
                    <div class="text-muted small">Reminders shown</div>
                    <div class="fs-3 fw-bold">{{ reminder_stats.total }}</div>
                </div></div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card h-100"><div class="card-body">
                    <div class="text-muted small">Fixed before posting</div>
                    <div class="fs-3 fw-bold text-success">{{ reminder_stats.fixed_percent }}%</div>
                    <div class="small text-muted">{{ reminder_stats.fixed }} times</div>
                </div></div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card h-100"><div class="card-body">
                    <div class="text-muted small">Cancelled</div>
                    <div class="fs-3 fw-bold">{{ reminder_stats.cancelled_percent }}%</div>
                    <div class="small text-muted">{{ reminder_stats.cancelled }} times</div>
                </div></div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card h-100"><div class="card-body">
                    <div class="text-muted small">Posted anyway</div>
                    <div class="fs-3 fw-bold text-danger">{{ reminder_stats.posted_anyway_percent }}%</div>
                    <div class="small text-muted">{{ reminder_stats.posted_anyway }} times{% if reminder_stats.pending %}, {{ reminder_stats.pending }} left without a decision{% endif %}</div>
                </div></div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Author</th>
                        <th>Type</th>
                        <th>Original text</th>
                        <th>Score before</th>
                        <th>Outcome</th>
                        <th>Score posted</th>
                        <th>Created At</th>
                    </tr>
                </thead>
                <tbody>
                    {% for reminder in recent_reminders %}
                    <tr>
                        <td><a href="{{ url_for('user_profile', username=reminder.username) }}">{{ reminder.username }}</a></td>
                        <td>{{ reminder.content_type }}</td>
                        <td style="max-width: 400px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="{{ reminder.original_content }}">{{ reminder.original_content }}</td>
                        <td>{{ reminder.original_score }}</td>
                        <td>
                            {% if reminder.outcome == 'fixed' %}
                                <span class="badge bg-success">Fixed</span>
                            {% elif reminder.outcome == 'cancelled' %}
                                <span class="badge bg-secondary">Cancelled</span>
                            {% elif reminder.outcome == 'posted_anyway' %}
                                <span class="badge bg-danger">Posted anyway</span>
                            {% else %}
                                <span class="badge bg-light text-dark border">No decision yet</span>
                            {% endif %}
                        </td>
                        <td>{{ reminder.final_score if reminder.final_score is not none else '-' }}</td>
                        <td>{{ reminder.created_at|datetimeformat }}</td>
                    </tr>
                    {% else %}
                    <tr><td colspan="7" class="text-center text-muted">No reminders yet.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Appeals Tab: members appeal automatic moderation, the admin decides (Design Claim 3) -->
    <div class="tab-pane fade {% if current_tab == 'appeals' %}show active{% endif %}" id="appeals" role="tabpanel" aria-labelledby="appeals-tab">
        <p class="text-muted">
            Members can appeal when the automatic moderation changed their post or comment.
            Approving shows the content as it was written; a rejection needs an explanation, which the member will see.
        </p>

        <h4>Open appeals</h4>
        {% for appeal in appeals if appeal.status == 'pending' %}
        <div class="card mb-3 border-warning">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span>
                        <a href="{{ url_for('user_profile', username=appeal.username) }}">@{{ appeal.username }}</a>
                        appealed the moderation of their {{ appeal.content_type }}
                    </span>
                    <small class="text-muted">
                        {{ appeal.created_at|datetimeformat }} · <a href="/posts/{{ appeal.post_id }}">view</a>
                    </small>
                </div>
                <p class="mb-1"><strong>Written:</strong> {{ appeal.content }}</p>
                <p class="mb-1"><strong>Shown after moderation:</strong> {{ appeal.moderated_content }}</p>
                <p class="mb-1">
                    <strong>Rules applied:</strong>
                    {% for v in appeal.violations %}{{ v.label }} (Rule {{ v.rule }}){% if v.text %}: "{{ v.text }}"{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}
                    · score {{ appeal.score }}
                </p>
                <p class="mb-3"><strong>Member's reason:</strong> "{{ appeal.reason }}"</p>

                <form action="{{ url_for('decide_appeal', appeal_id=appeal.id) }}" method="POST">
                    <label for="appeal-note-{{ appeal.id }}" class="form-label small">Explanation for the member (required when rejecting)</label>
                    <textarea class="form-control mb-2" id="appeal-note-{{ appeal.id }}" name="note" rows="2"></textarea>
                    <button type="submit" name="decision" value="approved" class="btn btn-success btn-sm me-2">Approve</button>
                    <button type="submit" name="decision" value="rejected" class="btn btn-danger btn-sm">Reject</button>
                </form>
            </div>
        </div>
        {% else %}
        <p class="text-muted">No open appeals.</p>
        {% endfor %}

        <!-- Earlier decisions, so similar cases can be decided consistently -->
        <h4 class="mt-4">Earlier decisions</h4>
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Author</th>
                        <th>Type</th>
                        <th>Rules applied</th>
                        <th>Member's reason</th>
                        <th>Decision</th>
                        <th>Explanation</th>
                        <th>Decided At</th>
                    </tr>
                </thead>
                <tbody>
                    {% for appeal in appeals if appeal.status != 'pending' %}
                    <tr>
                        <td><a href="{{ url_for('user_profile', username=appeal.username) }}">{{ appeal.username }}</a></td>
                        <td><a href="/posts/{{ appeal.post_id }}">{{ appeal.content_type }}</a></td>
                        <td>{% for v in appeal.violations %}{{ v.label }}{% if not loop.last %}, {% endif %}{% endfor %}</td>
                        <td style="max-width: 300px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="{{ appeal.reason }}">{{ appeal.reason }}</td>
                        <td>
                            {% if appeal.status == 'approved' %}
                                <span class="badge bg-success">Approved</span>
                            {% else %}
                                <span class="badge bg-danger">Rejected</span>
                            {% endif %}
                        </td>
                        <td>{{ appeal.admin_note or '-' }}</td>
                        <td>{{ appeal.decided_at|datetimeformat }}</td>
                    </tr>
                    {% else %}
                    <tr><td colspan="7" class="text-center text-muted">No decisions yet.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    // This JavaScript ensures the correct tab is active on page load/refresh
    document.addEventListener('DOMContentLoaded', function() {
        const urlParams = new URLSearchParams(window.location.search);
        const tab = urlParams.get('tab') || 'users'; // Default to 'users'

        // Deactivate all tabs and panes first
        document.querySelectorAll('.nav-link').forEach(link => link.classList.remove('active'));
        document.querySelectorAll('.tab-pane').forEach(pane => pane.classList.remove('show', 'active'));

        // Activate the correct tab and pane
        const activeTabButton = document.getElementById(tab + '-tab');
        const activeTabPage = document.getElementById(tab);
        
        if (activeTabButton) {
            activeTabButton.classList.add('active');
        }
        if (activeTabPage) {
            activeTabPage.classList.add('show', 'active');
        }
    });
</script>
</div>
{% endblock %}