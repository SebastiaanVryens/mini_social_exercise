{% extends "base.html.j2" %}
{% block content %}
{% from "macros/user_macros.html.j2" import user_display %}
{% from "macros/moderation_macros.html.j2" import moderation_notice, restored_label %}

<div class="col-md-8 mx-auto pt-4">
  <!-- Shown when the author of this post personally asked the current user to answer it -->
  {% if my_ask_request %}
  <div class="alert alert-info d-flex justify-content-between align-items-center">
    <span>{{ user_display(my_ask_request.requester) }} asked <strong>you</strong> personally to answer this post.</span>
    <div class="d-flex">
      <button class="btn btn-primary btn-sm me-2" data-bs-toggle="modal" data-bs-target="#addCommentModal-{{ post.id }}">Answer</button>
      <form action="{{ url_for('decline_request', request_id=my_ask_request.id) }}" method="POST">
        <button type="submit" class="btn btn-light btn-sm">Decline</button>
      </form>
    </div>
  </div>
  {% endif %}

  <div class="card shadow-sm">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">
          <a href="/u/{{ post.user_id }}">{{ user_display(post.username) }}</a>
        </h3>
        {% if session.get('user_id') == post.user_id %}
        <div class="d-flex align-items-center">
            <small class="text-muted me-3">{{ post.created_at|datetimeformat }}</small>
            <form action="{{ url_for('delete_post', post_id=post.id) }}" method="POST" onsubmit="return confirm('Are you sure you want to delete this post?');">
                <button type="submit" class="btn btn-danger" title="Delete Post">
                   delete
                </button>
            </form>
        </div>
        {% else %}
        <small class="text-muted">{{ post.created_at|datetimeformat }}</small>
        {% endif %}
      </div>
      
      <p class="card-text mt-2">{{ post.content }} {{ restored_label('post', post.id) }}</p>

      <!-- Only for the author: which rules changed this post, and the appeal (Design Claim 3) -->
      {% if post_notice %}{{ moderation_notice(post_notice) }}{% endif %}

      <!-- Reactions Display and Add Reaction Button (Copied from feed.html.j2) -->
      <div class="d-flex align-items-center mt-2 mb-2">
        <!-- Display existing reactions -->
        <div class="reactions-display me-2">
            {% if reactions %}
              {% for react in reactions %}
                <span class="text-dark me-1" title="{{ react.reaction_type|capitalize }}">
                  {{ reaction_emojis.get(react.reaction_type, '👍') }} {{ react.count }}
                </span>
              {% endfor %}
            {% else %}
              <span class="text-muted small">No reactions yet</span>
            {% endif %}
        </div>

        <!-- Add Reaction Dropdown Button -->
        {% if session.get('user_id') %}
        <div class="dropdown">
          <button class="btn btn-sm btn-light text-dark rounded-circle m-0" type="button" id="dropdownMenuButton-{{ post.id }}" data-bs-toggle="dropdown" aria-expanded="false" title="Add Reaction">
            +
          </button>
          <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton-{{ post.id }}">
            {% for reaction_type in reaction_types %}
            <li>
              <form action="{{ url_for('add_reaction') }}" method="POST" class="d-inline">
                <input type="hidden" name="post_id" value="{{ post.id }}">
                <input type="hidden" name="reaction" value="{{ reaction_type }}">
                <button type="submit" class="dropdown-item">
                  {{ reaction_emojis.get(reaction_type, '👍') }} {{ reaction_type|capitalize }}
                </button>
              </form>
            </li>
            {% endfor %}
          </ul>
        </div>
        {% endif %}
      </div>

      <!-- The author sees who they asked to answer this post, and whether those people answered -->
      {% if sent_asks %}
      {% set status_badges = {
        'pending': ('waiting', 'text-bg-secondary'),
        'answered': ('answered', 'text-bg-success'),
        'declined': ('declined', 'text-bg-danger')
      } %}
      <div class="small mb-2">
        <span class="text-muted me-1">You asked:</span>
        {% for ask in sent_asks %}
          <span class="me-2">{{ user_display(ask.username) }} <span class="badge {{ status_badges[ask.status][1] }}">{{ status_badges[ask.status][0] }}</span></span>
        {% endfor %}
      </div>
      {% endif %}

      <hr>

      <!-- Comments Section -->
      <div class="d-flex justify-content-between align-items-center mb-2">
          {% if comments %}
            <h4 class="mb-0">Comments ({{ comments | count }})</h4>
          {% else %}
            <h4 class="mb-0">Comments</h4>
          {% endif %}
          <div class="d-flex">
            <!-- Ask Someone Button (only for the author, triggers modal) -->
            {% if session.get('user_id') == post.user_id %}
            <button class="btn btn-light btn-sm me-2" data-bs-toggle="modal" data-bs-target="#askModal">Ask someone</button>
            {% endif %}
            <!-- Add Comment Button (triggers modal) -->
            <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addCommentModal-{{ post.id }}">Add Comment</button>
          </div>
      </div>

      {% if comments %}
      <ul class="list-group list-group-flush shadow-none border-0">
        {% for comment in comments %}
        <li class="card shadow-none p-2 mt-2">
          <div class="d-flex justify-content-between">
            <div>
              <strong><a href="/u/{{ comment.username }}">{{ user_display(comment.username) }}</a></strong>
              <p class="mb-0">{{ comment.content }} {{ restored_label('comment', comment.id) }}</p>
              {% if comment.notice %}{{ moderation_notice(comment.notice) }}{% endif %}
              
            
            {% if session.get('user_id') == comment.user_id or session.get('user_id') == post.user_id %}
            <form action="{{ url_for('delete_comment', comment_id=comment.id) }}" method="POST" onsubmit="return confirm('Are you sure you want to delete this comment?');">
                <button type="submit" class="btn btn-sm btn-danger" title="Delete Comment">delete</button>
            </form>
            {% endif %}

          </div>
        </li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
  </div>
</div>

<div class="modal fade" id="addCommentModal-{{ post.id }}" tabindex="-1" aria-labelledby="addCommentModalLabel-{{ post.id }}" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="addCommentModalLabel-{{ post.id }}">Add a comment</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form action="/posts/{{ post.id }}/comment" method="POST">
          <div class="mb-3">
            <label for="comment-content-{{ post.id }}" class="form-label">Your Comment</label>
            <textarea class="form-control" id="comment-content-{{ post.id }}" name="content" rows="3" required></textarea>
          </div>
          <button type="submit" class="btn btn-primary">Submit Comment</button>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- "Ask someone" modal: the author picks specific members to ask for an answer -->
{% if session.get('user_id') == post.user_id %}
<div class="modal fade" id="askModal" tabindex="-1" aria-labelledby="askModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="askModalLabel">Ask someone to answer</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="text-muted small">
          A question asked to one specific person gets answered more often than a question to everyone.
          You can ask up to {{ max_asks }} people per post.
        </p>

        {% if sent_asks|length >= max_asks %}
          <p class="mb-0">You have already asked {{ max_asks }} people about this post.</p>
        {% else %}
          <h6>Suggested for this post</h6>
          {% for suggestion in ask_suggestions %}
          <div class="d-flex justify-content-between align-items-center mb-2">
            <div>
              {{ user_display(suggestion.username) }}
              <div class="small text-muted">Has written about: {{ suggestion.topics|join(', ') }}</div>
            </div>
            <form action="{{ url_for('ask_someone', post_id=post.id) }}" method="POST">
              <input type="hidden" name="username" value="{{ suggestion.username }}">
              <button type="submit" class="btn btn-primary btn-sm">Ask</button>
            </form>
          </div>
          {% else %}
          <p class="small text-muted">No suggestions for this post. You can still ask a member by username below.</p>
          {% endfor %}

          <h6 class="mt-4">Or ask a member by username</h6>
          <form action="{{ url_for('ask_someone', post_id=post.id) }}" method="POST" class="d-flex">
            <input class="form-control me-2" name="username" list="ask-usernames" placeholder="username" required>
            <datalist id="ask-usernames">
              {% for name in ask_usernames %}<option value="{{ name }}">{% endfor %}
            </datalist>
            <button type="submit" class="btn btn-primary">Ask</button>
          </form>
        {% endif %}
      </div>
    </div>
  </div>
</div>
{% endif %}

<script>
  // Open the right modal when arriving from an "Ask someone" (#ask), "Answer" (#answer) or appeal (#appeal) link
  document.addEventListener("DOMContentLoaded", () => {
    const modalIds = {
      "#ask": "askModal",
      "#answer": "addCommentModal-{{ post.id }}",
      "#appeal": "appealModal-post-{{ post.id }}",
    };
    const modal = document.getElementById(modalIds[window.location.hash]);
    if (modal) {
      bootstrap.Modal.getOrCreateInstance(modal).show();
    }
  });
</script>

{% endblock %}